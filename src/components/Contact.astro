<style>
  .contact-inner {
    max-width: 80rem;
    margin: 0 auto;
    padding: 0 var(--space-xl);
  }

  .contact-links {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    max-width: 32rem;
  }

  .contact-link {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    padding: var(--space-lg);
    background: var(--surface);
    border: 1px solid var(--border-subtle);
    border-radius: 8px;
    color: var(--ink);
    transition: border-color 0.3s var(--ease-out-quart), box-shadow 0.3s var(--ease-out-quart);
  }

  .contact-link:hover {
    border-color: var(--primary-dim);
    box-shadow: 0 0 16px var(--primary-glow);
    color: var(--ink);
  }

  .contact-link:hover svg {
    color: var(--accent);
  }

  .contact-link svg {
    color: var(--primary);
    flex-shrink: 0;
  }

  .contact-label {
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--muted);
    min-width: 4rem;
  }

  .contact-value {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--ink);
  }
</style>
